# Build with the MSVC x86 toolchain and clang-cl's MSVC-compatible driver.
# Run from an x86 Native Tools Command Prompt with the LLVM tools installed.

!IFNDEF CLANG_CL
CLANG_CL = clang-cl
!ENDIF

TARGET = --target=i686-pc-windows-msvc
CFLAGS = /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS
LINKFLAGS = /MACHINE:X86 /INCREMENTAL:NO /MANIFEST:NO

all: build\d3d9.dll build\ddraw.dll

refrain: build\d3d9.dll

smd: build\ddraw.dll

smd-debug: build\debug\ddraw.dll

build:
	@if not exist build mkdir build

build\debug: build
	@if not exist build\debug mkdir build\debug

build\d3d9.dll: RefRain.c d3d9.def build
	$(CLANG_CL) $(TARGET) $(CFLAGS) /LD RefRain.c /link $(LINKFLAGS) /OUT:$@ /DEF:d3d9.def winmm.lib

build\ddraw.dll: Smd.c ddraw.def build
	$(CLANG_CL) $(TARGET) $(CFLAGS) /LD Smd.c /link $(LINKFLAGS) /OUT:$@ /DEF:ddraw.def /FORCE:MULTIPLE gdi32.lib dxguid.lib

build\debug\ddraw.dll: Smd.c ddraw.def build\debug
	$(CLANG_CL) $(TARGET) $(CFLAGS) /DSMD_DEBUG_BUILD /LD Smd.c /link $(LINKFLAGS) /OUT:$@ /DEF:ddraw.def /FORCE:MULTIPLE gdi32.lib dxguid.lib

clean:
	@if exist build rmdir /S /Q build
