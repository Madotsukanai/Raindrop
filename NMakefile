# Build x86 Windows DLLs with clang-cl and the MSVC linker.
# Run from an x86 Native Tools Command Prompt with LLVM tools installed.

!IFNDEF CLANG_CL
CLANG_CL = clang-cl
!ENDIF

TARGET = --target=i686-pc-windows-msvc
CFLAGS = /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS
LINKFLAGS = /MACHINE:X86 /INCREMENTAL:NO /MANIFEST:NO
VERSION_STAMP = build\.version-nmake

# Rust pixel kernels (raindrop-gpu crate). Build with the same 32-bit MSVC target:
#   cd rust\raindrop-gpu
#   cargo build --target i686-pc-windows-msvc --release
# Debug DLLs share the release kernels (they carry no logging of their own).
RUSTLIB = rust\raindrop-gpu\target\i686-pc-windows-msvc\release\libraindrop_gpu.lib
RUST_INCPATH = /Irust\raindrop-gpu\include
# Rust runtime libs needed when linking the staticlib into the DLL.
RUST_RUNTIME_LIBS = ws2_32.lib bcrypt.lib userenv.lib synchronization.lib ntdll.lib advapi32.lib

# Sync the VERSION macro in the sources from the VERSION file.
$(VERSION_STAMP): VERSION
	@if not exist build mkdir build
	@powershell -NoProfile -ExecutionPolicy Bypass -File tools\sync_version.ps1 -Stamp $(VERSION_STAMP)

all: build\d3d9.dll build\ddraw.dll

debug: build\debug\d3d9.dll build\debug\ddraw.dll

refrain: build\d3d9.dll

refrain-debug: build\debug\d3d9.dll

smd: build\ddraw.dll

smd-debug: build\debug\ddraw.dll

build:
	@if not exist build mkdir build

build\debug: build
	@if not exist build\debug mkdir build\debug

build\d3d9.dll: src\RefRain.c src\RainUpdate.h src\d3dx9_font_compat.h def\d3d9.def build $(VERSION_STAMP)
	$(CLANG_CL) $(TARGET) $(CFLAGS) /LD src\RefRain.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\d3d9.def user32.lib winmm.lib

build\debug\d3d9.dll: src\RefRain.c src\RainUpdate.h src\d3dx9_font_compat.h def\d3d9.def build\debug $(VERSION_STAMP)
	$(CLANG_CL) $(TARGET) $(CFLAGS) /DREFRAIN_DEBUG_BUILD /LD src\RefRain.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\d3d9.def user32.lib winmm.lib

build\ddraw.dll: src\Smd\Smd.c src\RainUpdate.h src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c src\Smd\Smd_internal.h rust\raindrop-gpu\include\raindrop_gpu.h $(RUSTLIB) def\ddraw.def build $(VERSION_STAMP)
	$(CLANG_CL) $(TARGET) $(CFLAGS) $(RUST_INCPATH) /LD src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\ddraw.def /FORCE:MULTIPLE user32.lib gdi32.lib dxguid.lib $(RUSTLIB) $(RUST_RUNTIME_LIBS)

build\debug\ddraw.dll: src\Smd\Smd.c src\RainUpdate.h src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c src\Smd\Smd_internal.h rust\raindrop-gpu\include\raindrop_gpu.h $(RUSTLIB) def\ddraw.def build\debug $(VERSION_STAMP)
	$(CLANG_CL) $(TARGET) $(CFLAGS) $(RUST_INCPATH) /DSMD_DEBUG_BUILD /LD src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\ddraw.def /FORCE:MULTIPLE user32.lib gdi32.lib dxguid.lib $(RUSTLIB) $(RUST_RUNTIME_LIBS)

clean:
	@if exist build rmdir /S /Q build
