# Build x86 Windows DLLs with clang-cl and the MSVC linker.
# Run from an x86 Native Tools Command Prompt with LLVM tools installed.

!IFNDEF CLANG_CL
CLANG_CL = clang-cl
!ENDIF

TARGET = --target=i686-pc-windows-msvc
CFLAGS = /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS
LINKFLAGS = /MACHINE:X86 /INCREMENTAL:NO /MANIFEST:NO

all: build\d3d9.dll build\ddraw.dll

debug: build\debug\d3d9.dll build\debug\ddraw.dll

refrain: build\d3d9.dll

refrain-debug: build\debug\d3d9.dll

smd: build\ddraw.dll

smd-debug: build\debug\ddraw.dll

build:
	@if not exist build mkdir build

build\debug: build
	@if not exist build\debug mkdir build\debug

build\d3d9.dll: src\RefRain.c src\d3dx9_font_compat.h def\d3d9.def build
	$(CLANG_CL) $(TARGET) $(CFLAGS) /LD src\RefRain.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\d3d9.def user32.lib winmm.lib

build\debug\d3d9.dll: src\RefRain.c src\d3dx9_font_compat.h def\d3d9.def build\debug
	$(CLANG_CL) $(TARGET) $(CFLAGS) /DREFRAIN_DEBUG_BUILD /LD src\RefRain.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\d3d9.def user32.lib winmm.lib

build\ddraw.dll: src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c src\Smd\Smd_internal.h def\ddraw.def build
	$(CLANG_CL) $(TARGET) $(CFLAGS) /LD src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\ddraw.def /FORCE:MULTIPLE user32.lib gdi32.lib dxguid.lib

build\debug\ddraw.dll: src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c src\Smd\Smd_internal.h def\ddraw.def build\debug
	$(CLANG_CL) $(TARGET) $(CFLAGS) /DSMD_DEBUG_BUILD /LD src\Smd\Smd.c src\Smd\Smd_d3d9.c src\Smd\Smd_controller.c /link $(LINKFLAGS) /OUT:$@ /DEF:def\ddraw.def /FORCE:MULTIPLE user32.lib gdi32.lib dxguid.lib

clean:
	@if exist build rmdir /S /Q build
