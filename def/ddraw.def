LIBRARY ddraw
EXPORTS
    ; DirectDraw API exports. Internal names use the x86 stdcall ABI.
    DirectDrawCreate            = _DirectDrawCreate@12
    DirectDrawCreateClipper     = _DirectDrawCreateClipper@12
    DirectDrawCreateEx          = _DirectDrawCreateEx@16
    DirectDrawEnumerateA        = _DirectDrawEnumerateA@8
    DirectDrawEnumerateExA      = _DirectDrawEnumerateExA@12
    DirectDrawEnumerateExW      = _DirectDrawEnumerateExW@12
    DirectDrawEnumerateW        = _DirectDrawEnumerateW@8

    ; COM server exports forwarded to the system DirectDraw DLL.
    DllCanUnloadNow             = _DllCanUnloadNow@0
    DllGetClassObject           = _DllGetClassObject@12
    DllRegisterServer           = _DllRegisterServer@0
    DllUnregisterServer         = _DllUnregisterServer@0

    ; Private exports of the system DirectDraw DLL that d3d8.dll / d3d9.dll import.  Each one jumps to the
    ; real system ddraw.dll function (see SMD_FWD_LIST in Smd_d3d9.c), so the argument list does not matter.
    AcquireDDThreadLock         = _SmdFwdStub_AcquireDDThreadLock
    ReleaseDDThreadLock         = _SmdFwdStub_ReleaseDDThreadLock
    CompleteCreateSysmemSurface = _SmdFwdStub_CompleteCreateSysmemSurface
    D3DParseUnknownCommand      = _SmdFwdStub_D3DParseUnknownCommand
    DDGetAttachedSurfaceLcl     = _SmdFwdStub_DDGetAttachedSurfaceLcl
    DDInternalLock              = _SmdFwdStub_DDInternalLock
    DDInternalUnlock            = _SmdFwdStub_DDInternalUnlock
    DSoundHelp                  = _SmdFwdStub_DSoundHelp
    GetDDSurfaceLocal           = _SmdFwdStub_GetDDSurfaceLocal
    GetOLEThunkData             = _SmdFwdStub_GetOLEThunkData
    GetSurfaceFromDC            = _SmdFwdStub_GetSurfaceFromDC
    RegisterSpecialCase         = _SmdFwdStub_RegisterSpecialCase
    SetAppCompatData            = _SmdFwdStub_SetAppCompatData
